# ====================================================================
# application.yml.example - 配置文件模板
# ====================================================================
# 这是给 GitHub 看的示例文件,所有真实值已替换成占位符。
# 本地使用步骤:
#   1. 复制本文件: cp application.yml.example application.yml
#   2. 把下面的 YOUR_* 占位符换成你的真实值
#   3. 直接启动后端即可(无需 --spring.profiles.active=local,无需环境变量)
#
# ⚠️ application.yml 已在 .gitignore 中,绝不会被提交
# ====================================================================

server:
  # 18090: 避开 Windows Hyper-V/WSL 端口保留区 9045-9144 (含 9090)
  port: 18090

spring:
  application:
    name: campus-lostfound

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # YOUR_DB_URL  → jdbc:mysql://你的IP:3306/campus_lostfound?...
    url: YOUR_DB_URL
    username: YOUR_DB_USERNAME
    # YOUR_DB_PASSWORD  → 你的 MySQL 密码
    password: YOUR_DB_PASSWORD

  data:
    redis:
      host: YOUR_REDIS_HOST
      port: YOUR_REDIS_PORT
      password: YOUR_REDIS_PASSWORD
      database: 0

  # 邮件:SMTP 配置。163 邮箱的"授权码"在 163 邮箱后台"POP3/SMTP/IMAP"处生成,不是登录密码。
  mail:
    host: YOUR_MAIL_HOST              # 如 smtp.163.com / smtp.qq.com
    port: YOUR_MAIL_PORT              # SSL 端口 465,STARTTLS 端口 25/587
    username: YOUR_MAIL_USERNAME      # 你的邮箱地址
    password: YOUR_MAIL_PASSWORD      # 邮箱"客户端授权码",不是登录密码!
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          auth: true
          # SSL 端口(465)用隐式 TLS;STARTTLS 端口(25/587)用 starttls.enable: true
          ssl:
            enable: true
            trust: YOUR_MAIL_SMTP_TRUST_HOST  # 如 smtp.163.com
        connectiontimeout: 10000
        timeout: 10000
        writetimeout: 10000


sa-token:
  token-name: Authorization
  # access token 有效期(秒)
  timeout: 900
  active-timeout: -1
  is-concurrent: true
  is-share: false
  token-style: uuid
  is-log: false
  is-read-cookie: false
  is-read-header: true
  token-prefix: Bearer
  # JWT 模式密钥(整个项目唯一 secret,>=32 字节)
  jwt-secret-key: YOUR_SA_TOKEN_JWT_SECRET

app:
  base-url: YOUR_FRONTEND_BASE_URL              # 如 http://localhost:3000
  init-demo-data: false                         # 是否自动初始化演示数据(生产 false)
  auto-fix-schema: false
  db-fix-enabled: false
  cors:
    allowed-origins: YOUR_CORS_ALLOWED_ORIGINS  # 如 http://localhost:3000
  auth:
    # 是否强制要求邮箱验证码注册。生产建议 true,本地联调可 false
    email-verification-required: false

image-bed:
  # 本地文件存储配置
  local-upload-path: ./uploads
  # 图片访问基础路径 (前端通过代理访问 /api/uploads/images/**)

logging:
  level:
    com.campus.lostfound: debug
    org.springframework.security: info
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
